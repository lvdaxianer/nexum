{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nexum/surfaces",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:smoke": "bun run build && bun test test/permission.smoke.spec.ts",
    "test:smoke:isolated": "export VITE_NEXUM_API_URL=http://127.0.0.1:4098 NEXUM_SMOKE_API_HOST=127.0.0.1 NEXUM_SMOKE_API_PORT=4098 NEXUM_SMOKE_UI_PORT=5174 && bun run build && bun test test/permission.smoke.spec.ts",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "catalog:",
    "@nexum/application": "workspace:*",
    "@nexum/client": "workspace:*",
    "@nexum/integrations": "workspace:*",
    "@nexum/persistence": "workspace:*",
    "dompurify": "catalog:",
    "marked": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@playwright/test": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.10"
  }
}
