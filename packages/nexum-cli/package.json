{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nexum/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexum": "./src/main.ts"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@nexum/client": "workspace:*",
    "@nexum/surface-adapter": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
