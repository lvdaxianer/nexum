{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": ["bunfig.toml", ".npmrc", "package.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "typecheck:tsc": {
      "dependsOn": ["transit"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
