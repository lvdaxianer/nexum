{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nexum",
  "description": "Composable Agent Runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --cwd packages/nexum-test dev",
    "dev:surface": "bun run --cwd packages/nexum-surfaces dev",
    "dev:server": "bun run --cwd packages/nexum-server dev",
    "cli": "bun run --cwd packages/nexum-cli start",
    "build": "bun turbo build",
    "build:packages": "bun run script/build-nexum.ts",
    "pack:nexum": "bun run script/pack-nexum.ts",
    "verify:nexum": "bun run script/verify-nexum.ts",
    "verify:docs": "bun run script/verify-nexum-docs.ts",
    "release:nexum:prepare": "bun run script/prepare-nexum-release.ts",
    "lint": "oxlint packages/nexum-*",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": ["packages/nexum-*"],
    "catalog": {
      "@kobalte/core": "0.13.13",
      "@playwright/test": "1.60.0",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.4.3",
      "dompurify": "3.4.17",
      "marked": "18.0.11",
      "solid-js": "1.9.17",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "vite": "7.3.7"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "babel-preset-solid": "1.9.15",
    "oxlint": "1.93.0",
    "turbo": "2.10.2",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": ["esbuild"],
  "overrides": {
    "@types/bun": "catalog:",
    "bun-types": "1.4.4",
    "solid-js": "catalog:"
  }
}
