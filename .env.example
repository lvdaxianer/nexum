# Runtime storage
NEXUM_DATA_DIR=.nexum
NEXUM_SESSION_FILE=.nexum/sessions.json
NEXUM_MESSAGE_FILE=.nexum/messages.json
NEXUM_EVENT_FILE=.nexum/events.json
NEXUM_INTERACTION_FILE=.nexum/interactions.json
NEXUM_MODEL_CONFIG_FILE=.nexum/model-config.json
NEXUM_ROLE_PROMPT_FILE=.nexum/role-prompt.json
NEXUM_SKILL_REGISTRY_FILE=.nexum/skills.json
NEXUM_PERMISSION_POLICY_FILE=.nexum/permission-policies.json

# Runtime and test endpoints
NEXUM_API_URL=http://127.0.0.1:4096
NEXUM_TEST_DATA_DIR=.nexum-test
NEXUM_SMOKE_API_HOST=localhost
NEXUM_SMOKE_API_PORT=4097
NEXUM_SMOKE_UI_PORT=5173

# Optional real-model smoke test configuration
NEXUM_MODEL=CHANGE_ME
NEXUM_MODEL_BASE_URL=https://api.example.com/v1
NEXUM_MODEL_API_KEY=CHANGE_ME
NEXUM_MODEL_SMOKE_MODE=CHANGE_ME

# Internal child-process parameters used by release preparation
NEXUM_RELEASE_VERSION=CHANGE_ME
NEXUM_RELEASE_TAG=beta
NEXUM_RELEASE_REGISTRY=https://registry.npmjs.org/
